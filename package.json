  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "sdk-ts": "openapi-generator-cli generate -i https://platform.opentenant.org/api-yaml -g typescript-fetch -o sdk/ts --openapi-generator-ignore-list 'README.md,package.json' --skip-validate-spec --additional-properties=npmName=ffmpeglab-platform-sdk,supportsES6=true,npmVersion=0.3.0,withInterfaces=true && rm sdk/ts/src/models/JitListAccessResponseItemsInnerAnyOf1.ts && echo 'export default {}' > sdk/ts/src/models/JitListAccessResponseItemsInnerAnyOf1.ts && rm sdk/ts/src/models/JitListAccessResponseItemsInner.ts && echo 'export default {}' > sdk/ts/src/models/JitListAccessResponseItemsInner.ts && rm sdk/ts/src/models/JitListAccessResponseItemsInnerAnyOf.ts && echo 'export default {}' > sdk/ts/src/models/JitListAccessResponseItemsInnerAnyOf.ts && rm sdk/ts/src/models/JitListAccessResponse.ts && echo 'export default {}' > sdk/ts/src/models/JitListAccessResponse.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^12.0.1",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/typeorm": "^11.0.3",
    "@scalar/nestjs-api-reference": "^1.2.14",
    "@supabase/server": "^1.4.1",
    "@supabase/supabase-js": "^2.112.3",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.0",
    "@types/express-session": "^1.19.0",
    "@types/js-yaml": "^4.0.9",
    "@types/passport-local": "^1.0.38",
    "client-oauth2": "^4.3.3",
    "dotenv": "^17.4.2",
    "express-session": "^1.19.0",
    "js-yaml": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "supabase-management-js": "^2.0.2",
    "typeorm": "1.1.0",
    "vault-client-typescript": "^0.3.10"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@openapitools/openapi-generator-cli": "^2.42.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
